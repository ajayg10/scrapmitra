{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CircularOption": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "enum": [
            "REUSE_SELL",
            "REUSE_DONATE",
            "REPAIR_THEN_REUSE",
            "RECYCLE_AUTHORIZED",
            "HAZARDOUS_SPECIAL_HANDLING"
          ],
          "title": "Option Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "money_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "env_rating": {
          "enum": [
            "much_better",
            "better",
            "good",
            "poor"
          ],
          "title": "Env Rating",
          "type": "string"
        },
        "co2e_avoided_min_kg": {
          "minimum": 0,
          "title": "Co2E Avoided Min Kg",
          "type": "number"
        },
        "co2e_avoided_max_kg": {
          "minimum": 0,
          "title": "Co2E Avoided Max Kg",
          "type": "number"
        },
        "viability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Viability",
          "type": "number"
        },
        "confidence_label": {
          "enum": [
            "High",
            "Medium",
            "Low"
          ],
          "title": "Confidence Label",
          "type": "string"
        },
        "why": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Why",
          "type": "string"
        },
        "assumption_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Assumption Id",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "title",
        "money_range",
        "env_rating",
        "co2e_avoided_min_kg",
        "co2e_avoided_max_kg",
        "viability",
        "confidence_label",
        "why",
        "assumption_id"
      ],
      "title": "CircularOption",
      "type": "object"
    },
    "ComparisonRow": {
      "additionalProperties": false,
      "properties": {
        "option_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Option Name",
          "type": "string"
        },
        "money_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Money Text",
          "type": "string"
        },
        "env_rating": {
          "enum": [
            "much_better",
            "better",
            "good",
            "poor"
          ],
          "title": "Env Rating",
          "type": "string"
        },
        "co2e_avoided_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Co2E Avoided Text",
          "type": "string"
        },
        "summary_reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary Reason",
          "type": "string"
        }
      },
      "required": [
        "option_name",
        "money_text",
        "env_rating",
        "co2e_avoided_text",
        "summary_reason"
      ],
      "title": "ComparisonRow",
      "type": "object"
    },
    "DecisionOutput": {
      "additionalProperties": false,
      "properties": {
        "recommended_tier": {
          "enum": [
            "REUSE_SELL",
            "REUSE_DONATE",
            "REPAIR_THEN_REUSE",
            "RECYCLE_AUTHORIZED",
            "HAZARDOUS_SPECIAL_HANDLING"
          ],
          "title": "Recommended Tier",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/CircularOption"
          },
          "title": "Options",
          "type": "array"
        },
        "comparison_table": {
          "items": {
            "$ref": "#/$defs/ComparisonRow"
          },
          "title": "Comparison Table",
          "type": "array"
        },
        "hazards": {
          "items": {
            "$ref": "#/$defs/LocalizedHazard"
          },
          "title": "Hazards",
          "type": "array"
        },
        "safety_gate_triggered": {
          "title": "Safety Gate Triggered",
          "type": "boolean"
        }
      },
      "required": [
        "recommended_tier",
        "options",
        "comparison_table",
        "hazards",
        "safety_gate_triggered"
      ],
      "title": "DecisionOutput",
      "type": "object"
    },
    "DeviceSummary": {
      "additionalProperties": false,
      "properties": {
        "device_type": {
          "enum": [
            "mobile_phone",
            "feature_phone",
            "laptop",
            "desktop_cpu",
            "crt_monitor",
            "lcd_monitor",
            "crt_tv",
            "led_tv",
            "keyboard",
            "mouse",
            "printer",
            "router_modem",
            "charger_adapter",
            "cables_wires",
            "ceiling_fan",
            "microwave",
            "washing_machine",
            "refrigerator",
            "air_conditioner",
            "inverter_ups",
            "battery_pack",
            "cfl_tube_light",
            "power_bank",
            "speaker_audio",
            "unknown"
          ],
          "title": "Device Type",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "brand": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Brand"
        },
        "condition": {
          "enum": [
            "looks_intact",
            "damaged",
            "burnt",
            "unknown"
          ],
          "title": "Condition",
          "type": "string"
        },
        "age_band": {
          "enum": [
            "lt3",
            "3to6",
            "6to10",
            "gt10",
            "unknown"
          ],
          "title": "Age Band",
          "type": "string"
        },
        "battery_present": {
          "title": "Battery Present",
          "type": "boolean"
        }
      },
      "required": [
        "device_type",
        "label",
        "brand",
        "condition",
        "age_band",
        "battery_present"
      ],
      "title": "DeviceSummary",
      "type": "object"
    },
    "LocalizedHazard": {
      "additionalProperties": false,
      "properties": {
        "hazard_id": {
          "enum": [
            "HAZ_LI_ION",
            "HAZ_LEAD_ACID",
            "HAZ_CRT_LEAD",
            "HAZ_MERCURY",
            "HAZ_REFRIGERANT",
            "HAZ_CAPACITOR_CHARGE",
            "HAZ_TONER_DUST",
            "HAZ_BROKEN_GLASS_LCD",
            "HAZ_PCB_BURN_FUMES",
            "HAZ_UNKNOWN_SEALED"
          ],
          "title": "Hazard Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "title": "Severity",
          "type": "string"
        },
        "icon": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Icon",
          "type": "string"
        },
        "warning": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Warning",
          "type": "string"
        },
        "do": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Do",
          "type": "array"
        },
        "dont": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Dont",
          "type": "array"
        },
        "exposure_help": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Exposure Help",
          "type": "string"
        },
        "disposal_route": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Disposal Route",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "draft",
            "approved"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "hazard_id",
        "severity",
        "icon",
        "warning",
        "do",
        "dont",
        "exposure_help",
        "disposal_route",
        "review_status"
      ],
      "title": "LocalizedHazard",
      "type": "object"
    },
    "MoneyRange": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "minimum": 0,
          "title": "Min",
          "type": "number"
        },
        "max": {
          "minimum": 0,
          "title": "Max",
          "type": "number"
        },
        "currency": {
          "const": "INR",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "min",
        "max",
        "currency"
      ],
      "title": "MoneyRange",
      "type": "object"
    },
    "NextAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "retake_photo",
            "arrange_pickup",
            "find_recycler",
            "contact_recycler"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Id"
        }
      },
      "required": [
        "kind",
        "label",
        "target_id"
      ],
      "title": "NextAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scan_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Scan Id",
      "type": "string"
    },
    "lang": {
      "enum": [
        "en",
        "hi"
      ],
      "title": "Lang",
      "type": "string"
    },
    "device": {
      "$ref": "#/$defs/DeviceSummary"
    },
    "decision": {
      "$ref": "#/$defs/DecisionOutput"
    },
    "hazards": {
      "items": {
        "$ref": "#/$defs/LocalizedHazard"
      },
      "title": "Hazards",
      "type": "array"
    },
    "is_demo": {
      "title": "Is Demo",
      "type": "boolean"
    },
    "needs_more_photos": {
      "title": "Needs More Photos",
      "type": "boolean"
    },
    "suggested_angle": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Suggested Angle"
    },
    "audio_script": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Audio Script",
      "type": "string"
    },
    "next_actions": {
      "items": {
        "$ref": "#/$defs/NextAction"
      },
      "title": "Next Actions",
      "type": "array"
    }
  },
  "required": [
    "scan_id",
    "lang",
    "device",
    "decision",
    "hazards",
    "is_demo",
    "needs_more_photos",
    "suggested_angle",
    "audio_script",
    "next_actions"
  ],
  "title": "AppraisalResponse",
  "type": "object"
}
