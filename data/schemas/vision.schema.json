{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "VisionPart": {
      "additionalProperties": false,
      "properties": {
        "part_id": {
          "enum": [
            "pcb_low",
            "pcb_mid",
            "pcb_high",
            "copper_wire",
            "copper_winding",
            "aluminium",
            "steel",
            "brass",
            "plastic_abs",
            "li_ion_cell",
            "lead_acid_cell",
            "compressor",
            "crt_tube",
            "lcd_panel",
            "ram_chip",
            "cpu_chip",
            "hdd_drive",
            "capacitor_large",
            "magnet_neodymium",
            "toner_cartridge",
            "unknown_part"
          ],
          "title": "Part Id",
          "type": "string"
        },
        "est_weight_g_min": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Est Weight G Min",
          "type": "number"
        },
        "est_weight_g_max": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Est Weight G Max",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "part_id",
        "est_weight_g_min",
        "est_weight_g_max",
        "confidence"
      ],
      "title": "VisionPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "device_type": {
      "enum": [
        "mobile_phone",
        "feature_phone",
        "laptop",
        "desktop_cpu",
        "crt_monitor",
        "lcd_monitor",
        "crt_tv",
        "led_tv",
        "keyboard",
        "mouse",
        "printer",
        "router_modem",
        "charger_adapter",
        "cables_wires",
        "ceiling_fan",
        "microwave",
        "washing_machine",
        "refrigerator",
        "air_conditioner",
        "inverter_ups",
        "battery_pack",
        "cfl_tube_light",
        "power_bank",
        "speaker_audio",
        "unknown"
      ],
      "title": "Device Type",
      "type": "string"
    },
    "brand_guess": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Brand Guess"
    },
    "condition": {
      "enum": [
        "looks_intact",
        "damaged",
        "burnt",
        "unknown"
      ],
      "title": "Condition",
      "type": "string"
    },
    "age_band": {
      "enum": [
        "lt3",
        "3to6",
        "6to10",
        "gt10",
        "unknown"
      ],
      "title": "Age Band",
      "type": "string"
    },
    "visible_damage": {
      "items": {
        "enum": [
          "cracked_screen",
          "bent_frame",
          "burn_marks",
          "swollen_battery",
          "water_damage",
          "missing_parts",
          "corrosion"
        ],
        "type": "string"
      },
      "maxItems": 10,
      "title": "Visible Damage",
      "type": "array"
    },
    "battery_present": {
      "title": "Battery Present",
      "type": "boolean"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/VisionPart"
      },
      "maxItems": 32,
      "title": "Parts",
      "type": "array"
    },
    "hazards_detected": {
      "items": {
        "enum": [
          "HAZ_LI_ION",
          "HAZ_LEAD_ACID",
          "HAZ_CRT_LEAD",
          "HAZ_MERCURY",
          "HAZ_REFRIGERANT",
          "HAZ_CAPACITOR_CHARGE",
          "HAZ_TONER_DUST",
          "HAZ_BROKEN_GLASS_LCD",
          "HAZ_PCB_BURN_FUMES",
          "HAZ_UNKNOWN_SEALED"
        ],
        "type": "string"
      },
      "maxItems": 32,
      "title": "Hazards Detected",
      "type": "array"
    },
    "overall_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Overall Confidence",
      "type": "number"
    },
    "needs_more_photos": {
      "title": "Needs More Photos",
      "type": "boolean"
    },
    "suggested_angle": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Suggested Angle"
    },
    "unknowns": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Unknowns",
      "type": "array"
    }
  },
  "required": [
    "device_type",
    "brand_guess",
    "condition",
    "age_band",
    "visible_damage",
    "battery_present",
    "parts",
    "hazards_detected",
    "overall_confidence",
    "needs_more_photos",
    "suggested_angle",
    "unknowns"
  ],
  "title": "VisionOutput",
  "type": "object"
}
